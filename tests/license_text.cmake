if(NOT DEFINED SOURCE_DIR)
    get_filename_component(SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()

file(READ "${SOURCE_DIR}/LICENSE" _license)
if(NOT _license MATCHES "Apache License")
    message(FATAL_ERROR "LICENSE is not the Apache License")
endif()
if(NOT _license MATCHES "Version 2.0, January 2004")
    message(FATAL_ERROR "LICENSE is missing the Apache-2.0 version line")
endif()
if(NOT _license MATCHES "http://www.apache.org/licenses/")
    message(FATAL_ERROR "LICENSE is missing the Apache license URL")
endif()
if(_license MATCHES "MIT License")
    message(FATAL_ERROR "LICENSE still contains an MIT License heading")
endif()
if(_license MATCHES "Permission is hereby granted")
    message(FATAL_ERROR "LICENSE still contains the MIT grant")
endif()

file(READ "${SOURCE_DIR}/NOTICE" _notice)
if(NOT _notice MATCHES "Copyright \\(c\\) 2026 iisacc")
    message(FATAL_ERROR "NOTICE is missing Copyright (c) 2026 iisacc")
endif()
if(NOT _notice MATCHES "Apache License")
    message(FATAL_ERROR "NOTICE does not name the Apache License")
endif()

file(READ "${SOURCE_DIR}/README.md" _readme)
if(NOT _readme MATCHES "SPDX-License-Identifier: Apache-2.0")
    message(FATAL_ERROR "README SPDX identifier is not Apache-2.0")
endif()
if(_readme MATCHES "SPDX-License-Identifier: MIT")
    message(FATAL_ERROR "README still identifies the module as MIT")
endif()

file(READ "${SOURCE_DIR}/docs/License.md" _korean)
if(NOT _korean MATCHES "SPDX-License-Identifier: Apache-2.0")
    message(FATAL_ERROR "docs/License.md SPDX identifier is not Apache-2.0")
endif()

if(DEFINED BINARY_DIR)
    file(READ "${BINARY_DIR}/iiLocalLLMConfig.cmake" _config)
    if(NOT _config MATCHES "set\\(iiLocalLLM_SPDX_LICENSE \"Apache-2.0\"\\)")
        message(FATAL_ERROR "Package config does not export iiLocalLLM_SPDX_LICENSE=Apache-2.0")
    endif()
endif()
