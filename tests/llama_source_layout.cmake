if(NOT IS_DIRECTORY "${LLAMA_SOURCE}")
    message(FATAL_ERROR "The llama target source directory is missing")
endif()
file(REAL_PATH "${LLAMA_SOURCE}" _llama)
file(REAL_PATH "${BUILD_ROOT}" _build)
cmake_path(IS_PREFIX _build "${_llama}" NORMALIZE _in_build)
if(_in_build AND NOT LLAMA_OVERRIDE)
    message(FATAL_ERROR "The default llama source must not be stored in the build tree")
endif()
if(NOT LLAMA_OVERRIDE)
    file(REAL_PATH "${SOURCE_ROOT}/resources/dependencies/llama.cpp" _resources)
    cmake_path(IS_PREFIX _resources "${_llama}" NORMALIZE _in_resources)
    if(NOT _in_resources)
        message(FATAL_ERROR "The default llama target must use its project resource source")
    endif()
endif()
