if(NOT EXISTS "${BUILD_ROOT}/build.ninja")
    message(STATUS "Default-target graph check applies to Ninja builds")
    return()
endif()
file(STRINGS "${BUILD_ROOT}/build.ninja" _all REGEX "^build all: phony ")
if(NOT _all)
    message(FATAL_ERROR "Ninja default build graph not found")
endif()
foreach(_target iiLocalLLMRuntimeSmoke iiLocalLLMCpuRuntimeSmoke)
    if(" ${_all} " MATCHES " ${_target} ")
        set(_found TRUE)
    else()
        set(_found FALSE)
    endif()
    if(EXPECT_INFERENCE AND NOT _found)
        message(FATAL_ERROR "Configured inference test target ${_target} is missing")
    elseif(NOT EXPECT_INFERENCE AND _found)
        message(FATAL_ERROR "Manual inference target ${_target} is in the default build")
    endif()
endforeach()
