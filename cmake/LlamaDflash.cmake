# Declare graph constructor specializations before their first instantiation.
# This pinned revision repeats the ordering defect in DFlash and Eagle3.
function(iilocal_fix_dflash_specializations)
    get_target_property(_source_root llama SOURCE_DIR)
    get_target_property(_sources llama SOURCES)
    set(_kept "")
    foreach(_item IN LISTS _sources)
        if(IS_ABSOLUTE "${_item}")
            set(_source "${_item}")
        else()
            set(_source "${_source_root}/${_item}")
        endif()
        if(NOT _source MATCHES "[.]cpp$" OR NOT EXISTS "${_source}")
            list(APPEND _kept "${_item}")
            continue()
        endif()
        file(READ "${_source}" _contents)
        string(REGEX MATCHALL "template[ \n]*<>[ \n]+[A-Za-z0-9_:]+::graph<[^>]+>::graph\\([^)]*\\)" _constructors "${_contents}")
        string(REGEX MATCH "std::unique_ptr<llm_graph_context> [A-Za-z0-9_:]+::build_arch_graph\\(" _anchor "${_contents}")
        if(NOT _constructors OR NOT _anchor)
            list(APPEND _kept "${_item}")
            continue()
        endif()
        set(_declarations "")
        foreach(_constructor IN LISTS _constructors)
            string(APPEND _declarations "${_constructor};\n")
        endforeach()
        string(REPLACE "${_anchor}" "${_declarations}\n${_anchor}" _patched "${_contents}")
        get_filename_component(_name "${_source}" NAME)
        set(_copy "${CMAKE_CURRENT_BINARY_DIR}/llama-patches/${_name}")
        get_filename_component(_original_directory "${_source}" DIRECTORY)
        set_source_files_properties("${_copy}" TARGET_DIRECTORY llama
            PROPERTIES INCLUDE_DIRECTORIES "${_original_directory}")
        file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/llama-patches")
        set(_existing "")
        if(EXISTS "${_copy}")
            file(READ "${_copy}" _existing)
        endif()
        if(NOT _existing STREQUAL _patched)
            file(WRITE "${_copy}" "${_patched}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_source}")
        list(APPEND _kept "${_copy}")
    endforeach()
    set_property(TARGET llama PROPERTY SOURCES "${_kept}")
endfunction()
