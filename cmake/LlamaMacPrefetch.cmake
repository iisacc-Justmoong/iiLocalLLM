# Keep mmap but avoid an unbounded whole-file POSIX_MADV_WILLNEED on macOS.
# Compile a generated copy so fetched and explicitly supplied checkouts are not
# modified. Reject unknown upstream source until this narrow change is reviewed.
function(iilocal_disable_macos_eager_llama_prefetch)
    if(NOT APPLE OR NOT CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        return()
    endif()
    get_target_property(_root llama SOURCE_DIR)
    set(_original "${_root}/llama-model.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_original}")
    file(READ "${_original}" _source)
    set(_before [=[    ml.init_mappings(true, use_mlock ? &pimpl->mlock_mmaps : nullptr);]=])
    set(_after [=[    ml.init_mappings(false, use_mlock ? &pimpl->mlock_mmaps : nullptr);]=])
    string(FIND "${_source}" "${_before}" _position)
    if(_position EQUAL -1)
        string(FIND "${_source}" "${_after}" _already_fixed)
        if(_already_fixed EQUAL -1)
            message(FATAL_ERROR "Unknown llama model loader: review macOS mmap prefetch behavior")
        endif()
        return()
    endif()
    string(REPLACE "${_before}" "" _remaining "${_source}")
    string(LENGTH "${_source}" _original_length)
    string(LENGTH "${_remaining}" _remaining_length)
    string(LENGTH "${_before}" _anchor_length)
    math(EXPR _removed "${_original_length} - ${_remaining_length}")
    if(NOT _removed EQUAL _anchor_length)
        message(FATAL_ERROR "Cannot identify a unique llama mmap prefetch call")
    endif()
    string(REPLACE "${_before}" "${_after}" _patched "${_source}")
    set(_copy "${CMAKE_CURRENT_BINARY_DIR}/llama-patches/macos-llama-model.cpp")
    file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/llama-patches")
    set(_existing "")
    if(EXISTS "${_copy}")
        file(READ "${_copy}" _existing)
    endif()
    if(NOT _existing STREQUAL _patched)
        file(WRITE "${_copy}" "${_patched}")
    endif()
    get_target_property(_sources llama SOURCES)
    set(_updated "")
    set(_replacements 0)
    foreach(_item IN LISTS _sources)
        get_filename_component(_absolute "${_item}" ABSOLUTE BASE_DIR "${_root}")
        if(_absolute STREQUAL _original)
            list(APPEND _updated "${_copy}")
            math(EXPR _replacements "${_replacements} + 1")
        else()
            list(APPEND _updated "${_item}")
        endif()
    endforeach()
    if(NOT _replacements EQUAL 1)
        message(FATAL_ERROR "Cannot identify the llama model source uniquely")
    endif()
    set_source_files_properties("${_copy}" TARGET_DIRECTORY llama
        PROPERTIES INCLUDE_DIRECTORIES "${_root}")
    set_property(TARGET llama PROPERTY SOURCES "${_updated}")
endfunction()
