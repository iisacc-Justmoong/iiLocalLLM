    {
      "id": "b000009",
      "kind": "paragraph",
      "start_line": 20,
      "end_line": 22,
      "raw": "The MemoryHeaderInterop regression passes. The remaining full-suite failures\nprevent installation in this maintenance run. No tests are disabled. Native\nmodel inference that requires separately provisioned weights was not exercised.\n"
    }
